---
// src/layouts/Base.astro

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Iyosias | Brand and Web Design",
  description = "Brand identity designer and creative director. I help ambitious companies build brands and websites that match what they have built.",
  image = "/og-image.png",
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph: Telegram, WhatsApp, LinkedIn, Facebook, iMessage, Slack -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Iyosias" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Iyosias: what if your brand matched what you have built?" />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- KEEP FROM YOUR OLD Base.astro (if you had them): favicon, analytics,
         font preloads, `import "../index.css"` in the frontmatter, etc.
         Example:
         <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    -->
  </head>
  <body>
    <slot />
  </body>
</html>