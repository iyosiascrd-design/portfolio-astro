---
import "../index.css"

interface Props {
  title?: string
  description?: string
  image?: string
  /** Hero image to preload for speed (not used for the share preview) */
  hero?: string
  type?: "website" | "article"
  /** Extra JSON-LD structured data objects for this page */
  jsonLd?: Record<string, unknown>[]
}

const SITE_BIO =
  "Brand identity designer and creative director in Addis Ababa, Ethiopia. I help ambitious businesses build distinctive brands through strategy, visual identity, web design and 3D visualization."

const {
  title = "Iyosias | Brand Identity Designer",
  description = "Brand identity designer and creative director in Addis Ababa, Ethiopia. Strategy, visual identity, digital design and 3D visualization for ambitious businesses.",
  image = "/og-image.png",
  hero,
  type = "website",
  jsonLd = [],
} = Astro.props

// Site-wide Person data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Iyosias",
  url: Astro.site?.href,
  image: new URL("/portrait.jpeg", Astro.site).href,
  jobTitle: "Brand Identity Designer and Creative Director",
  description: SITE_BIO,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Addis Ababa",
    addressCountry: "ET",
  },
  knowsAbout: [
    "Brand strategy",
    "Brand identity design",
    "Graphic design",
    "Digital design",
    "Web design",
    "3D visualization",
    "Presentation design",
    "Motion graphics",
  ],
  sameAs: [
    "https://www.instagram.com/iyosias.t/",
    "https://www.linkedin.com/in/iyosias-tekezeshoa-3524031ba/",
    "https://x.com/IyosiasTeke",
  ],
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

// Home page: the mobile LCP image is the first carousel card (Weyra).
// It is rendered by React, so the browser can't discover it from the HTML.
// Preloading it lets the download start immediately, while JS is still loading.
// Note: the space in the file name must be written as %20 here.
const isHome = Astro.url.pathname === "/"
const HOME_MOBILE_HERO = "/weyra%20home.jpeg"
const ogImage = new URL(image, Astro.site)

// Derive image MIME type from file extension
const IMAGE_TYPES: Record<string, string> = {
  jpg: "image/jpeg",
  jpeg: "image/jpeg",
  png: "image/png",
  webp: "image/webp",
}

const ext = ogImage.pathname.split(".").pop()?.toLowerCase() ?? ""
const ogImageType = IMAGE_TYPES[ext] ?? "image/png"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Iyosias" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={title} />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    {jsonLd.map((data) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(data)}
      />
    ))}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preload the mobile LCP image on the home page -->
    {isHome && (
      <link
        rel="preload"
        as="image"
        href={HOME_MOBILE_HERO}
        media="(max-width: 767px)"
        fetchpriority="high"
      />
    )}

    <!-- Preload hero image on work pages -->
    {hero && (
      <link
        rel="preload"
        as="image"
        href={hero}
        fetchpriority="high"
      />
    )}
  </head>

  <body>
    <slot />
  </body>
</html>